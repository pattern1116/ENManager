# ── AI Speaking Coach — environment ──────────────────────────────
# Copy to .env.local and adjust. Defaults below = fully local dev.

# ── LLM ──────────────────────────────────────────────────────────
# mock | claude | openai | ollama | lmstudio | openai-compat
LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=http://localhost:11434   # ollama / lmstudio

# ── STT ──────────────────────────────────────────────────────────
# mock | local (mlx-whisper server) | openai-api
STT_PROVIDER=mock
STT_BASE_URL=http://localhost:9797      # local mlx-whisper server (svc-managed)
STT_MODEL=small                         # size name or full HF repo id
# STT_API_KEY=                          # only for STT_PROVIDER=openai-api

# ── TTS (Small Talk listen+speak) — Kokoro via newsbot :8787 ─────
# /api/tts proxies to the TTS server; auth never reaches the browser. When
# nothing below is set, the client falls back to the browser's speechSynthesis
# (robotic) — set TTS_SESSION_SECRET for the natural Kokoro voices.
# TTS_BASE_URL=http://localhost:8787
# Preferred: share the TTS server's SESSION_SECRET; /api/tts mints a short-lived
# HMAC session token from it (works locally + in prod, no Turnstile).
# TTS_SESSION_SECRET=
# TTS_TOKEN=                              # alt: a pre-minted static x-session-token
# TTS_VOICE=af_heart                      # af_heart/af_bella/af_sarah/am_adam/am_michael/bf_emma/bm_george

# ── Database ─────────────────────────────────────────────────────
DB_PATH=./data/speaking-coach.db

# ── Auth ─────────────────────────────────────────────────────────
# 4-digit access codes (comma-separated). The entered code becomes the
# user id. REQUIRED — with this unset nobody can log in. Pick your own
# secret code; never commit a real one to the repo.
AUTH_CODES=1234
